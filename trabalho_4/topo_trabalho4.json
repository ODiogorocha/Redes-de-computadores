{
  "_comment": "Metadados da topologia - Trabalho 4 UFSM. Reaproveita integralmente a topologia do Trabalho 3 (topo_trabalho2.json). A topologia é instanciada por Mininet + BMv2 simple_switch, com a mesma porta thrift 9090 já usada no Trabalho 3.",
  "topology": {
    "hosts": {
      "h1": { "ip": "10.0.1.1/24", "mac": "00:00:00:00:01:01", "role": "sender / gerador de tráfego" },
      "h2": { "ip": "10.0.2.2/24", "mac": "00:00:00:00:02:02", "role": "receiver" },
      "h3": { "ip": "10.0.3.3/24", "mac": "00:00:00:00:03:03", "role": "controlador (controller.py) e ponto de coleta da telemetria" }
    },
    "switches": {
      "s1": {
        "type": "bmv2_simple_switch",
        "thrift_port": 9090,
        "program": "build/telemetria_trabalho4.json",
        "ports": { "1": "h1", "2": "h2", "3": "h3" }
      }
    },
    "links": [
      { "src": "h1", "dst": "s1", "src_port": "h1-eth0", "dst_port": 1 },
      { "src": "h2", "dst": "s1", "src_port": "h2-eth0", "dst_port": 2 },
      { "src": "h3", "dst": "s1", "src_port": "h3-eth0", "dst_port": 3 }
    ]
  },
  "telemetria_janela_global": {
    "_comment": "Reaproveitada do Trabalho 3, sem alterações. Usada apenas para acompanhamento/monitoramento.",
    "approach": "packet_cloning",
    "clone_session": 99,
    "clone_egress_port": 3,
    "etype": "0x9999",
    "window_size_packets": 10,
    "metrics": [
      { "name": "pkt_count",      "bits": 32, "description": "Pacotes observados na janela" },
      { "name": "byte_count",     "bits": 32, "description": "Bytes observados na janela" },
      { "name": "min_ttl",        "bits":  8, "description": "TTL mínimo observado na janela" },
      { "name": "dominant_proto", "bits":  8, "description": "Protocolo IP mais frequente (1=ICMP,6=TCP,17=UDP)" }
    ]
  },
  "telemetria_por_fluxo": {
    "_comment": "NOVO no Trabalho 4. Base para a decisão automática do controlador.",
    "approach": "packet_cloning",
    "clone_session": 99,
    "clone_egress_port": 3,
    "etype": "0x9998",
    "report_every_n_packets_of_flow": 8,
    "flow_key": "hdr.ipv4.srcAddr (indexado pelo último octeto)",
    "metrics": [
      { "name": "srcAddr",    "bits": 32, "description": "IP de origem do fluxo (identifica o tráfego)" },
      { "name": "pkt_count",  "bits": 32, "description": "Pacotes acumulados do fluxo" },
      { "name": "byte_count", "bits": 32, "description": "Bytes acumulados do fluxo" },
      { "name": "min_ttl",    "bits":  8, "description": "TTL mínimo do fluxo" }
    ]
  },
  "politica_de_decisao": {
    "tabela": "MyIngress.traffic_action",
    "populada_por": "controller.py (dinamicamente, via simple_switch_CLI / thrift, porta 9090)",
    "chave": "hdr.ipv4.srcAddr (exact)",
    "limiares": {
      "MARK_PKT_THRESHOLD": 40,
      "BLOCK_PKT_THRESHOLD": 100,
      "IDLE_TIMEOUT_SEC": 20
    },
    "acoes_possiveis": ["no_action", "mark_flow(dscp)", "drop_flow", "redirect_flow(port)"],
    "acoes_usadas_na_demonstracao": ["mark_flow (DSCP=46) ao ultrapassar MARK_PKT_THRESHOLD",
                                      "drop_flow ao ultrapassar BLOCK_PKT_THRESHOLD",
                                      "remoção automática da regra após IDLE_TIMEOUT_SEC sem telemetria do fluxo"]
  }
}
